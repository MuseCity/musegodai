{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "musecity",
  "account_id": "4b68bb6b6c38892162610027f25fbb0d",
  "main": "workers/app.ts",
  "compatibility_date": "2026-09-22",
  "compatibility_flags": [
    "nodejs_compat",
    "global_fetch_strictly_public"
  ],
  "workers_dev": false,
  "preview_urls": false,
  "images": { "binding": "IMAGES" },
  "routes": [{ "pattern": "musegod.ai", "custom_domain": true }],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "vars": {
    "APP_ORIGIN": "https://musegod.ai",
    "PRIVY_APP_ID": "cmug6tppl01ry0ejlx0asnge8"
  },
  "r2_buckets": [
    {
      "binding": "MEDIA",
      "bucket_name": "musecity-media"
    }
  ],
  "hyperdrive": [
    {
      "binding": "DATABASE",
      "id": "b69f95f4f29d439982e812296dd27531",
      "localConnectionString": "postgres://musecity_app:local-only-not-configured@127.0.0.1:65433/musecity"
    }
  ]
}
